---
layout: layouts/base.njk
title: Notizie
sottotitolo: Le attività, gli incontri e gli aggiornamenti della Fondazione Paulus.
pagination:
  data: collections.notizie
  size: 12
  alias: elenco
permalink: "/notizie/{% if pagination.pageNumber > 0 %}pagina-{{ pagination.pageNumber + 1 }}/{% endif %}"
---
{%- import "schede.njk" as s -%}
<div class="contenitore pagina-testa">
  <nav class="briciole" aria-label="Percorso"><a href="/">Home</a><span aria-hidden="true">/</span>Notizie</nav>
  <h1>Notizie</h1>
  <p>{{ sottotitolo }}</p>
</div>
<div class="contenitore" style="padding-bottom:80px">
  {%- if elenco.length %}
  <div class="griglia">{% for n in elenco %}{{ s.notizia(n) }}{% endfor %}</div>
  {%- else %}
  <p class="vuoto">Non ci sono ancora notizie.</p>
  {%- endif %}
  {%- if pagination.pages.length > 1 %}
  <nav class="paginazione" aria-label="Pagine">
    {%- if pagination.href.previous %}<a class="pulsante contorno" href="{{ pagination.href.previous }}">← Più recenti</a>{% endif %}
    {%- if pagination.href.next %}<a class="pulsante contorno" href="{{ pagination.href.next }}">Meno recenti →</a>{% endif %}
  </nav>
  {%- endif %}
</div>
